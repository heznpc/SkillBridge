{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "src/shared/learning-records.js",
    "src/lib/learning-record-client.js",
    "src/types/**/*.d.ts",
    "src/lib/runtime-contracts.js",
    "src/lib/translation-corrections.js",
    "tests/types/**/*.ts",
    "src/content/translation-corrections.js",
    "src/content/learning-records.js"
  ],
  "exclude": ["node_modules", "dist", "src/bridge/puter.js"]
}
