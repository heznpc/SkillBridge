---
import type { Locale } from '../i18n';
import { getCopy, lessonSamples, localePath, locales, languageNames } from '../i18n';
import { formatText } from '../locale';
import { buildInfo } from '../data/build-info';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const storeUrl = 'https://chromewebstore.google.com/detail/skillbridge-for-anthropic/oancfldkbnajdadgekkjpdnhepjjcdln';
const releaseUrl = `https://github.com/heznpc/skillBridge/releases/tag/v${buildInfo.version}`;
const privacyUrl = `${base}privacy.html`;

const { ui, titleLines, featureItems, demo: demoText, common, tools, sample } = getCopy(locale);
const clientCopy = { demo: demoText, common, tools };
const previewLabel = formatText(common.previewLabel, { language: languageNames[locale] });
---
<div data-landing data-locale={locale} data-site-base={base} data-copy={JSON.stringify(clientCopy)} data-samples={JSON.stringify(lessonSamples)}>
<header class="flow-header shell">
  <a class="mark" href={localePath(locale, base)} aria-label={common.home}>
    <img src={`${base}images/icon128.png`} alt="" width="34" height="34" />
    <span>SkillBridge</span>
  </a>
  <nav class="flow-nav" aria-label={common.navigation}>
    <a href="#flow">{ui.navFlow}</a>
    <a href="#context">{ui.navContext}</a>
    <a href="#languages">{ui.navLanguages}</a>
  </nav>
  <div class="header-right">
    <label class="locale-switch" aria-label={common.chooseLanguage}>
      <span>{common.language}</span>
      <select data-locale-select aria-label={common.chooseLanguage}>
        {locales.map((code) => <option value={code} selected={code === locale} lang={code}>{languageNames[code]}</option>)}
      </select>
    </label>
    <a class="header-install" href={storeUrl}>{ui.install}</a>
  </div>
</header>

<aside class="locale-prompt shell" data-locale-prompt hidden>
  <p data-locale-prompt-text></p>
  <button type="button" data-locale-prompt-toggle>{common.language}</button>
</aside>

<main>
  <section class="opening shell" aria-labelledby="opening-title">
    <div class="opening-index"><span>01</span><i></i><small>{ui.eyebrow}</small></div>
    <div class="opening-copy">
      <h1 id="opening-title">{titleLines[0]}<br /><span>{titleLines[1]}</span></h1>
      <p>{ui.lead}</p>
      <p class="version-notice"><strong>{common.version}</strong> {ui.versionNotice}<span class="validation-boundary"><b>{common.validation}</b> {ui.validationNotice}</span></p>
      <a class="anchor-link" href="#flow"><span>↓</span>{ui.launch}</a>
    </div>
    <div class="opening-meta"><span>{ui.languageCount}</span><span>{ui.local}</span></div>
  </section>

  <section class="journey" id="flow" aria-labelledby="journey-title">
    <div class="journey-header shell"><div><p class="section-kicker">02 / {ui.demoLabel}</p><h2 id="journey-title">{ui.flowTitle}</h2></div><p>{ui.flowLead}</p></div>

  <div class="journey-stage shell">
    <aside class="journey-rail" aria-label={ui.flowAria}>
      <button class="rail-item active" type="button" data-flow-step="popup" aria-current="step"><span>01</span><p>{ui.stepOpen}</p></button>
      <button class="rail-item" type="button" data-flow-step="language"><span>02</span><p>{ui.stepChoose}</p></button>
      <button class="rail-item" type="button" data-flow-step="sidebar"><span>03</span><p>{ui.stepStay}</p></button>
    </aside>
    <div class="extension-demo" data-extension-demo data-locale={locale}>
      <figure class="extension-capture">
        <img src={`${base}images/lesson-translated.png`} alt={ui.lessonAlt} />
        <div class="translation-preview" data-translation-preview aria-live="polite">
          <small data-preview-label>{previewLabel}</small>
          <strong data-preview-title lang={locale}>{sample.title}</strong>
          <p data-preview-body lang={locale}>{sample.body}</p>
        </div>
        <figcaption><span class="capture-dot"></span>{ui.local}</figcaption>
      </figure>
      <aside class="extension-popup" aria-label={ui.settingsAria}>
        <div class="extension-popup-head"><img src={`${base}images/icon128.png`} alt="" width="26" height="26" /><div><strong>SkillBridge</strong><small>{common.productDescription}</small></div></div>
        <label class="extension-field"><span>{demoText.language}</span><select data-popup-language>{buildInfo.supportedLanguages.map(({ code, label }) => <option value={code} selected={code === locale} lang={code}>{label}</option>)}</select></label>
        <label class="extension-toggle"><input type="checkbox" data-auto-translate checked /><span>{demoText.auto}</span></label>
        <label class="extension-toggle"><input type="checkbox" data-comment-translate /><span>{demoText.comments}</span></label>
        <button class="extension-sidebar-button" type="button" data-sidebar-toggle aria-controls={`demo-sidebar-${locale}`} aria-expanded="false">{demoText.openSidebar}</button>
        <p class="extension-status" data-extension-status aria-live="polite">{demoText.currentLesson}</p>
      </aside>
      <aside class="extension-sidebar" id={`demo-sidebar-${locale}`} data-extension-sidebar hidden aria-label="SkillBridge Tutor">
        <div class="extension-sidebar-head"><strong>SkillBridge Tutor</strong><button type="button" data-tools-toggle aria-controls={`demo-tools-${locale}`} aria-expanded="false" aria-label={demoText.learningTools}><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/></svg></button><button type="button" data-sidebar-close aria-label={demoText.closeSidebar}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></svg></button></div>
        <div class="extension-chat"><div class="extension-chat-message"><span>AI</span><p data-tutor-message>{demoText.tutorGreeting}</p></div><div class="extension-example-questions"><button type="button" data-demo-question>{demoText.askPassage}</button></div><div class="extension-chat-input"><textarea rows="1" data-chat-input aria-label={demoText.askPassage} placeholder={demoText.askPassage}></textarea><button type="button" data-chat-send>{demoText.send}</button></div><small class="extension-demo-disclosure" data-chat-feedback aria-live="polite">{demoText.chatPreview}</small></div>
        <div class="extension-tools-menu" id={`demo-tools-${locale}`} data-tools-menu hidden aria-label={demoText.learningTools}><button type="button" data-tool-preview="recent" aria-pressed="false">{demoText.recentLessons}</button><button type="button" data-tool-preview="bookmarks" aria-pressed="false">{demoText.bookmarks}</button><button type="button" data-tool-preview="notes" aria-pressed="false">{demoText.notes}</button><button type="button" data-tool-preview="reports" aria-pressed="false">{demoText.reports}</button><button type="button" data-tool-preview="flashcards" aria-pressed="false">{demoText.flashcards}</button><button type="button" data-tool-preview="pdf" aria-pressed="false">{demoText.exportPdf}</button></div>
      </aside>
    </div>
  </div>

    <div class="journey-notes shell"><article><span>01</span><div><h3>{ui.stepOpen}</h3><p>{ui.stepOpenBody}</p></div></article><article><span>02</span><div><h3>{ui.stepChoose}</h3><p>{ui.stepChooseBody}</p></div></article></div>
  </section>

  <section class="context-zone" id="context" aria-labelledby="context-title">
    <div class="context-copy shell"><p class="section-kicker">03 / {ui.contextEyebrow}</p><h2 id="context-title">{ui.contextTitle}</h2><p>{ui.contextBody}</p></div>
    <figure class="context-image shell"><img src={`${base}images/lesson-translated.png`} alt={ui.contextAlt} /><figcaption><img src={`${base}images/icon128.png`} alt="" width="30" height="30" /><div><strong>{ui.stepStay}</strong><p>{ui.contextNote}</p></div></figcaption></figure>
  </section>

  <section class="feature-zone shell" id="features" aria-labelledby="features-title">
    <div class="feature-header"><div><p class="section-kicker">04 / {ui.featureEyebrow}</p><h2 id="features-title">{ui.featureTitle}</h2></div><p>{ui.featureLead}</p></div>
    <div class="feature-grid">{featureItems.map(([title, body], index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{title}</h3><p>{body}</p></div></article>)}</div>
  </section>

  <section class="language-zone shell" id="languages" aria-labelledby="languages-title">
    <div><p class="section-kicker">05 / {ui.languageMore}</p><h2 id="languages-title">{ui.languageTitle}</h2><p>{ui.languageLead}</p></div>
    <ul>{buildInfo.supportedLanguages.filter(({ code }) => code !== 'en').map(({ code, label }) => <li><a href={localePath(code as Locale, base)} hreflang={code} lang={code} dir="auto">{label}</a></li>)}</ul>
  </section>

  <section class="finish shell"><div class="finish-line"><span>06</span><i></i><small>{ui.flowTag}</small></div><div class="finish-copy"><h2>{ui.finalTitle}</h2><p>{ui.finalBody}</p></div><div class="finish-actions"><a class="install-button" href={storeUrl}>{ui.install}</a><a class="source-link" href={releaseUrl}>{ui.source}</a></div></section>
</main>

<footer class="flow-footer shell"><a class="mark" href={localePath(locale, base)}><img src={`${base}images/icon128.png`} alt="" width="28" height="28" /><span>SkillBridge</span></a><p>{ui.footer}</p><nav><a href={privacyUrl}>{ui.privacy}</a><a href="https://github.com/heznpc/skillBridge">{ui.sourceLabel}</a><a href="https://github.com/heznpc/skillBridge/blob/main/LICENSE">{ui.license}</a></nav></footer>

</div>

<script>
  import '../landing';
</script>
