---
import type { Locale } from '../i18n';
import { copy, localePath } from '../i18n';
import { buildInfo } from '../data/build-info';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const ui = copy[locale];
const base = import.meta.env.BASE_URL;
const storeUrl = 'https://chromewebstore.google.com/detail/skillbridge-for-anthropic/oancfldkbnajdadgekkjpdnhepjjcdln';
const releaseUrl = `https://github.com/heznpc/skillBridge/releases/tag/v${buildInfo.version}`;
const privacyUrl = `${base}privacy.html`;
const demo = locale === 'ko' ? { language: '번역 언어', auto: '이 강의 자동 번역', comments: '댓글 번역', open: 'Tutor 열기', close: 'Tutor 닫기', ask: '이 문단에 대해 질문하기', send: '보내기', ready: '데모에서는 아무것도 전송하지 않습니다.' } : { language: 'Translate to', auto: 'Auto-translate this lesson', comments: 'Translate comments', open: 'Open Tutor', close: 'Close Tutor', ask: 'Ask about this passage', send: 'Send', ready: 'This preview does not send anything.' };
---
<header class="site-header shell">
  <a class="brand" href={localePath('en', base)} aria-label="SkillBridge home"><img src={`${base}images/icon128.png`} alt="" width="30" height="30" /><span>SkillBridge</span></a>
  <nav aria-label="Primary navigation"><a href="#experience">{ui.nav.experience}</a><a href="#tools">{ui.nav.tools}</a><a href="#how">{ui.nav.how}</a></nav>
  <div class="header-actions"><a class="locale" href={localePath(locale === 'en' ? 'ko' : 'en', base)}>{locale === 'en' ? '한국어' : 'EN'}</a><a class="button button-small" href={storeUrl}>{ui.nav.install}<span aria-hidden="true">↗</span></a></div>
</header>
<main>
  <section class="hero shell" id="experience"><div class="hero-copy"><h1>{ui.hero.title.split('\n').map((line, index) => <span>{line}{index < ui.hero.title.split('\n').length - 1 && <br />}</span>)}</h1><p>{ui.hero.lead}</p><div class="hero-actions"><a class="button" href={storeUrl}>{ui.hero.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href="#demo">{ui.hero.secondary}<span aria-hidden="true">↓</span></a></div><ul class="assurances">{ui.hero.assurances.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul></div>
    <div class="hero-product" id="demo" data-extension-demo data-locale={locale}><div class="browser-frame"><div class="browser-bar"><span class="window-dots"><i></i><i></i><i></i></span><span class="address">academy.anthropic.com / courses / prompting</span></div><div class="lesson-pane"><small>Lesson 02</small><h2>Prompting fundamentals</h2><p>Learn how to write effective prompts, iterate on results, and evaluate outputs.</p><div class="lesson-tabs"><span class="active">Lesson</span><span>Notes</span><span>Discussion</span></div><h3>What makes a good prompt?</h3><p>A good prompt is clear, specific, and provides relevant context.</p><pre>Explain the difference between supervised and unsupervised learning.</pre></div><aside class="extension-panel"><div class="panel-brand"><img src={`${base}images/icon128.png`} alt="" width="24" height="24" /><strong>SkillBridge</strong></div><label><span>{demo.language}</span><select data-popup-language><option value="en">English</option><option value="ko" selected={locale === 'ko'}>한국어</option><option value="ja">日本語</option><option value="es">Español</option></select></label><label class="check"><input type="checkbox" data-auto-translate checked />{demo.auto}</label><label class="check"><input type="checkbox" data-comment-translate />{demo.comments}</label><button class="panel-button" type="button" data-sidebar-toggle aria-expanded="false">{demo.open}</button><small class="panel-status" data-extension-status>Translation is enabled for this lesson.</small></aside><aside class="tutor-panel" data-extension-sidebar hidden><div class="tutor-head"><strong>SkillBridge Tutor</strong><button type="button" data-sidebar-close aria-label={demo.close}>×</button></div><div class="tutor-body"><p class="tutor-message">{locale === 'ko' ? '강의 내용을 떠나지 않고 질문해 보세요.' : 'Ask about the lesson without leaving the page.'}</p><button class="question" type="button" data-demo-question>{demo.ask}</button><div class="chat-row"><textarea rows="1" data-chat-input aria-label={demo.ask} placeholder={demo.ask}></textarea><button type="button" data-chat-send>{demo.send}</button></div><small data-chat-feedback>{demo.ready}</small></div></aside></div></div>
  </section>
  <section class="proof-band shell" aria-label={locale === 'ko' ? '핵심 기능' : 'Core benefits'}>{ui.proof.cards.map((card) => <article><span class="proof-number">{card.id}</span><div><h2>{card.title}</h2><p>{card.body}</p><small>{card.note}</small></div></article>)}</section>
  <section class="tools-section shell" id="tools"><div class="section-intro"><p class="kicker">{ui.tools.eyebrow}</p><h2>{ui.tools.title}</h2><p>{ui.tools.lead}</p><a class="text-link" href="#how">{locale === 'ko' ? '사용 방법 보기' : 'See how it works'} <span aria-hidden="true">→</span></a></div><div class="tool-list">{ui.tools.items.map((item, index) => <div class="tool-row"><span>0{index + 1}</span><p>{item}</p><span aria-hidden="true">↗</span></div>)}<div class="tool-note"><span aria-hidden="true">◌</span><div><strong>{ui.tools.noteTitle}</strong><p>{ui.tools.noteBody}</p></div></div></div></section>
  <section class="steps-section shell" id="how"><div class="section-intro"><p class="kicker">{ui.steps.eyebrow}</p><h2>{ui.steps.title}</h2><p>{ui.steps.lead}</p></div><div class="steps-list">{ui.steps.items.map((step) => <article><span class="step-index">{step.id}</span><div><h3>{step.title}</h3><p>{step.body}</p><small>{step.note}</small></div></article>)}</div></section>
  <section class="final-cta shell"><h2>{ui.cta.title}</h2><p>{ui.cta.lead}</p><div><a class="button" href={storeUrl}>{ui.cta.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href={releaseUrl}>{ui.cta.source}<span aria-hidden="true">→</span></a></div></section>
</main>
<footer class="site-footer shell"><a class="brand" href={localePath('en', base)}><img src={`${base}images/icon128.png`} alt="" width="26" height="26" /><span>SkillBridge</span></a><p>{ui.footer.disclaimer}</p><nav><a href={privacyUrl}>{ui.footer.privacy}</a><a href="https://github.com/heznpc/skillBridge">{ui.footer.source}</a><a href="https://github.com/heznpc/skillBridge/blob/main/LICENSE">{ui.footer.license}</a></nav></footer>
<script>
  document.querySelectorAll('[data-extension-demo]').forEach((demo) => {
    const sidebar = demo.querySelector('[data-extension-sidebar]'); const toggle = demo.querySelector('[data-sidebar-toggle]'); const close = demo.querySelector('[data-sidebar-close]'); const language = demo.querySelector('[data-popup-language]'); const auto = demo.querySelector('[data-auto-translate]'); const comments = demo.querySelector('[data-comment-translate]'); const status = demo.querySelector('[data-extension-status]'); const question = demo.querySelector('[data-demo-question]'); const input = demo.querySelector('[data-chat-input]'); const send = demo.querySelector('[data-chat-send]'); const feedback = demo.querySelector('[data-chat-feedback]'); const ko = demo.dataset.locale === 'ko';
    const setStatus = (text) => { status.textContent = text; }; const setSidebar = (open) => { sidebar.hidden = !open; toggle.setAttribute('aria-expanded', String(open)); if (open) close.focus(); };
    toggle.addEventListener('click', () => setSidebar(sidebar.hidden)); close.addEventListener('click', () => { setSidebar(false); toggle.focus(); });
    language.addEventListener('change', () => setStatus(ko ? `번역 언어를 ${language.options[language.selectedIndex].text}로 설정했습니다.` : `Language set to ${language.options[language.selectedIndex].text}.`));
    auto.addEventListener('change', () => setStatus(ko ? (auto.checked ? '자동 번역을 켰습니다.' : '자동 번역을 일시 중지했습니다.') : (auto.checked ? 'Automatic translation is enabled.' : 'Automatic translation is paused.')));
    comments.addEventListener('change', () => setStatus(ko ? (comments.checked ? '댓글 번역을 켰습니다.' : '댓글 번역을 껐습니다.') : (comments.checked ? 'Comment translation is enabled.' : 'Comment translation is disabled.')));
    question.addEventListener('click', () => { input.value = question.textContent.trim(); input.focus(); }); const preview = () => { if (!input.value.trim()) input.value = question.textContent.trim(); feedback.textContent = ko ? '질문 흐름 미리보기입니다. 외부로 전송되지 않습니다.' : 'Question flow preview shown. Nothing was sent outside this page.'; }; send.addEventListener('click', preview); input.addEventListener('keydown', (event) => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); preview(); } });
  });
</script>
