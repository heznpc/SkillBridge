---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Landing from '../../components/Landing.astro';
import { getCopy, locales, type Locale } from '../../i18n';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const locale = Astro.props.locale as Locale;
const { meta } = getCopy(locale);
---
<SiteLayout title={meta.title} description={meta.description} locale={locale}>
  <Landing locale={locale} />
</SiteLayout>
