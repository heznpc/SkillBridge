---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Landing from '../../components/Landing.astro';
import { copy, locales, type Locale } from '../../i18n';
import { buildInfo } from '../../data/build-info';

export function getStaticPaths() {
  return locales.filter((locale) => locale !== 'en').map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const locale = Astro.props.locale as Locale;
const languageLabel = buildInfo.supportedLanguages.find(({ code }) => code === locale)?.label ?? locale;
---
<SiteLayout title={`SkillBridge · ${languageLabel}`} description={copy.en.description} locale={locale}>
  <Landing locale={locale} />
</SiteLayout>
